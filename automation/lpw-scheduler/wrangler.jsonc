{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lpw-hourly-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["7 * * * *"]
  }
}
